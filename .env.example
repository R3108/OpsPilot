# ---------- core ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# `make keys` will generate these for you
SECRET_KEY=change-me-32-bytes-minimum-secret-key
ENCRYPTION_KEY=change-me-base64-32-byte-kek=

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# ---------- data ----------
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
# psycopg-style DSN used by the LangGraph Postgres checkpointer
CHECKPOINT_DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
REDIS_URL=redis://localhost:6379/0

# ---------- llm ----------
# anthropic | nvidia | fake   (fake runs the offline heuristic engine)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPSPILOT_MODEL=claude-sonnet-5
OPSPILOT_MODEL_FAST=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

# ---------- nvidia nim (used when LLM_PROVIDER=nvidia) ----------
# Hosted catalogue: get an nvapi-... key from https://build.nvidia.com
# Self-hosted NIM container: set NVIDIA_BASE_URL=http://localhost:8000/v1 and
# leave NVIDIA_API_KEY empty.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# function_calling (tool-capable models) | json_schema (guided decoding)
NVIDIA_STRUCTURED_OUTPUT_METHOD=function_calling
# Optional: your per-million-token rates, for the cost column in run reports.
NVIDIA_PRICE_PER_MTOK_INPUT=0.0
NVIDIA_PRICE_PER_MTOK_OUTPUT=0.0

# ---------- langsmith ----------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=opspilot
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---------- frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---------- safety ----------
# Global kill switch: when true no remediation executes, ever.
REMEDIATION_DISABLED=false
AUTO_APPROVE_LOW_RISK=true
MAX_AGENT_ITERATIONS=3
INVESTIGATION_TIMEOUT_SECONDS=600
